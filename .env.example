# Copy this file to .env and fill in real values.
#   cp .env.example .env
#   chmod 600 .env
#
# After editing: `scripts/setup.sh`
#
# This file mostly holds non-LLM credentials. Codex and OpenCode are
# authenticated subscription-style via interactive CLI commands inside the
# container. Cursor can also use `agent login`, but headless automation is more
# reliable with the optional CURSOR_API_KEY below.

# === Local identity ==========================================================
# Assistant display name used in runtime instructions and chat identity.
ASSISTANT_NAME=

# Docker-safe slug used for container, image, Compose project, and volume names.
# Lowercase letters, numbers, and hyphens only. Example: hermes-dev-assistant
ASSISTANT_SLUG=

# Primary human operator/team name used in runtime instructions.
USER_NAME=

# Git author identity used for commits created inside workbench clones.
GIT_USER_NAME=
GIT_USER_EMAIL=

# Branch prefix for assistant-created task branches.
BRANCH_PREFIX=assistant

# Localhost ports. Change these if you run multiple Hermes assistants.
DASHBOARD_PORT=9119
API_PORT=8642

# Inner Docker daemon storage driver. Keep overlay2 unless dockerd fails on
# your host/VM; fuse-overlayfs is the usual fallback for unusual nested setups.
DOCKERD_STORAGE_DRIVER=overlay2

# === Telegram (only chat surface for now) ====================================
# 1. DM @BotFather on Telegram, send /newbot, save the token here.
TELEGRAM_BOT_TOKEN=

# 2. DM @userinfobot on Telegram, save your numeric ID here.
#    Without this set, Hermes denies ALL incoming messages by default.
#    Multiple users: comma-separated, e.g. 123456789,987654321
TELEGRAM_ALLOWED_USERS=

# === GitHub (gh CLI on your real account, scope-trimmed classic PAT) =========
# Classic PAT (https://github.com/settings/tokens → "Generate new token (classic)").
# Fine-grained PATs are scoped to a single owner and can't cover multiple orgs,
# so we use classic and trim the dangerous scopes off instead.
# GitHub exposes gist access as one `gist` scope. Add it only if you want the
# assistant to read and create gists through `gh gist`.
#
# Tick EXACTLY these:
#   - repo        (clone, push, PRs, issues)
#   - gist        (read and create GitHub Gists)
#   - read:org    (list repos across your orgs)
#
# Leave UNTICKED (these are the safety boundary):
#   - delete_repo  → token cannot delete repositories
#   - admin:*      → no org / webhook / SSH-key / GPG admin
#   - workflow     → cannot push changes under .github/workflows/
#   - notifications, user, codespace, project, packages — not needed
#
# If any org enforces SAML SSO: after creating the token, visit each org's
# settings page and click "Configure SSO" → Authorize next to the new token,
# else gh shows the token as valid but org repos won't appear.
#
# `gh` CLI reads GH_TOKEN automatically — no `gh auth login` needed.
# Git also picks it up via the credential helper baked into the image,
# so `git push` to github.com just works inside the assistant's working clones.
#
# After editing GH_TOKEN: `docker compose up -d` (NOT `restart` — Compose only
# re-reads env_file on container recreation, not on restart).
GH_TOKEN=

# === Optional: Cursor Agent CLI ==============================================
# Cursor user API key for headless local CLI runs (`agent -p`) inside Docker.
# Generate one from:
# https://cursor.com/dashboard/api?section=user-keys#user-api-keys
# Leave blank if you prefer `docker compose exec -u hermes -it assistant agent login`.
CURSOR_API_KEY=

# === Optional: external API server ===========================================
# Leave as `false` unless something outside this host needs to talk to Hermes.
# Even then, prefer SSH-tunnelling localhost:8642 over exposing the port.
API_SERVER_ENABLED=false
# API_SERVER_KEY=   # `openssl rand -hex 32` if you turn the server on
