# Local setup state and accidental secret files
.assistant/
.*
!.dockerignore
!.gitignore

# Runtime state lives in Docker volumes, but keep these ignored in case local
# restore folders exist.
data/
workbench/

# Backups and exported state
*.tar
*.tar.gz
*.tgz
*.zip
*-state-*.tar.gz
hermes-assistant-backup-*.tar.gz

# Credentials and keys
auth.json
*.pem
*.key
*.p12
*.pfx

# Logs, caches, and temp files
*.log
.cache/
.tmp/
tmp/

# OS/editor noise
.DS_Store
*.swp
*.swo
.idea/
.vscode/
